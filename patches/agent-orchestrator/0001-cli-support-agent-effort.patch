From 1140dd62dc7bb588b987e2c44aa1ff4796fa732b Mon Sep 17 00:00:00 2001
From: Antigravity Agent <agent@local>
Date: Wed, 23 Sep 2026 02:16:00 +0700
Subject: [PATCH] fix(cli): add effort support to project config and spawn command

Preserves reasoning effort in CLI project get-config / set-config commands
and exposes the --effort flag in ao spawn to allow setting reasoning effort
for sessions from the CLI.

Base SHA: 1140dd62dc7bb588b987e2c44aa1ff4796fa732b
---
 backend/internal/cli/project.go | 1 +
 backend/internal/cli/spawn.go   | 3 +++
 2 files changed, 4 insertions(+)

diff --git a/backend/internal/cli/project.go b/backend/internal/cli/project.go
index e3412ab..75a431c 100644
--- a/backend/internal/cli/project.go
+++ b/backend/internal/cli/project.go
@@ -35,6 +35,7 @@ type projectConfig struct {
 
 type agentConfig struct {
 	Model       string `json:"model,omitempty"`
+	Effort      string `json:"effort,omitempty"`
 	Mode        string `json:"mode,omitempty"`
 	Permissions string `json:"permissions,omitempty"`
 }
diff --git a/backend/internal/cli/spawn.go b/backend/internal/cli/spawn.go
index 923af12..d8341ae 100644
--- a/backend/internal/cli/spawn.go
+++ b/backend/internal/cli/spawn.go
@@ -32,6 +32,7 @@ type spawnOptions struct {
 	issue           string
 	name            string
 	model           string
+	effort          string
 	claimPR         string
 	noTakeover      bool
 	skipAgentCheck  bool
@@ -48,6 +49,7 @@ type spawnRequest struct {
 	Branch          string `json:"branch,omitempty"`
 	Prompt          string `json:"prompt,omitempty"`
 	Model           string `json:"model,omitempty"`
+	Effort          string `json:"effort,omitempty"`
 	DisplayName     string `json:"displayName"`
 }
@@ -101,6 +103,7 @@ func newSpawnCommand(ctx *commandContext) *cobra.Command {
 	f.StringVar(&opts.prompt, "prompt", "", "Initial prompt for the agent")
 	f.StringVar(&opts.model, "model", "", "Agent model override for this session only (e.g. sonnet, gpt-5.6-sol); overrides project/role config without changing it")
+	f.StringVar(&opts.effort, "effort", "", "Agent reasoning effort override for this session (e.g. low, medium, high); overrides project/role config without changing it")
 	f.StringVar(&opts.issue, "issue", "", "Issue id to associate with the session")
 	f.StringVar(&opts.trackerProvider, "tracker-provider", "github", "Issue tracker provider: github or gitlab (default: github)")
 	f.StringVar(&opts.name, "name", "", "Display name shown in the sidebar (required, max 100 characters)")
-- 
